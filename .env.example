COMPOSE_PROJECT_NAME=isac-2026
HOST_UID=1000
HOST_GID=1000
APP_PORT=8080
VITE_PORT=5173
GOOGLE_SHEET_API_URL=
GOOGLE_SHEET_API_KEY=
GOOGLE_SHEET_API_TIMEOUT=15
GOOGLE_SHEET_API_RETRIES=3
GOOGLE_SHEET_API_ENABLED=false
DB_FORWARD_PORT=3307

APP_NAME="ISAC 2026"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8080
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

AUTH_GUARD=teams
AUTH_PASSWORD_BROKER=teams
AUTH_PASSWORD_TIMEOUT=10800

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=isac2026
DB_USERNAME=isac
DB_PASSWORD=isac_password
DB_ROOT_PASSWORD=root_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_COOKIE=isac_2026_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,localhost:5173,127.0.0.1,127.0.0.1:8080,127.0.0.1:5173
SANCTUM_TOKEN_PREFIX=

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_EHLO_DOMAIN=localhost
MAIL_FROM_ADDRESS="verified-sender@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BREVO_API_KEY=
BREVO_SENDER_EMAIL="${MAIL_FROM_ADDRESS}"
BREVO_SENDER_NAME="${APP_NAME}"
TRANSACTIONAL_MAIL_TRANSPORT=brevo
BREVO_API_URL=https://api.brevo.com/v3
BREVO_TIMEOUT=10
BREVO_RETRIES=2
BREVO_SANDBOX=false

IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=

REGISTRATION_PAYMENT_INSTRUCTIONS="Ikuti instruksi pembayaran resmi panitia ISAC."
REGISTRATION_QR_IMAGE_URL=/qris.png
REGISTRATION_PROMO_CODE=ISAXOP
REGISTRATION_PROMO_DISCOUNT_PERCENT=15

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
