COMPOSE_PROJECT_NAME=isac-2026-prod
APP_PORT=80

APP_NAME="ISAC 2026"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_A_REAL_APP_KEY
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://isac.example.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

AUTH_GUARD=teams
AUTH_PASSWORD_BROKER=teams
AUTH_PASSWORD_TIMEOUT=10800

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=isac2026
DB_USERNAME=isac
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_ROOT_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_COOKIE=isac_2026_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=isac.example.com
SANCTUM_TOKEN_PREFIX=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_EHLO_DOMAIN=isac.example.com
MAIL_FROM_ADDRESS="verified-sender@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BREVO_API_KEY=
BREVO_SENDER_EMAIL="${MAIL_FROM_ADDRESS}"
BREVO_SENDER_NAME="${APP_NAME}"
TRANSACTIONAL_MAIL_TRANSPORT=brevo
BREVO_API_URL=https://api.brevo.com/v3
BREVO_TIMEOUT=10
BREVO_RETRIES=2
BREVO_SANDBOX=false

IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=

REGISTRATION_PAYMENT_INSTRUCTIONS="Ikuti instruksi pembayaran resmi panitia ISAC."
REGISTRATION_QR_IMAGE_URL=/qris.png
REGISTRATION_PROMO_CODE=ISAXOP
REGISTRATION_PROMO_DISCOUNT_PERCENT=15

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
