    });

Route::fallback(function () {
    if (request()->is('api/*')) {
        abort(404);
    }

    return Inertia::render('Errors/NotFound', [
        'status' => 404,
        'errorPage' => true,
    ])
        ->toResponse(request())
        ->setStatusCode(404);
});
